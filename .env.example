# Real Estate Investment System - Environment Variables
# Copy this file to .env and fill in your actual values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/real_estate_investment

# ── Apify (required for Zillow comps) ────────────────────────────────────────
APIFY_API_KEY=your_apify_api_key_here

# ── PropStream (browser automation — local only) ──────────────────────────────
# Credentials used by execution/enrichment/propstream_enricher.py
# A headed browser opens locally; MFA/Captcha can be solved manually.
PROPSTREAM_USERNAME=your_propstream_email@example.com
PROPSTREAM_PASSWORD=your_propstream_password

# ── Google APIs (optional) ────────────────────────────────────────────────────
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here   # Used as fallback for beds/baths parsing

# ── System Configuration ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
STALE_DATA_THRESHOLD=7

# ── BidWise Dashboard (Vercel) ────────────────────────────────────────────────
VERCEL_LIVE_URL=https://bidwiseai.vercel.app
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# ── QR affiliate + vendor flows (web/, set in Vercel) ─────────────────────────
# Salt for one-way IP hashing in the affiliate scan ledger (random 32+ chars).
# Raw IPs are never stored; without a salt, hashes are unsalted (warned in logs).
AFF_IP_SALT=generate_a_random_32_char_string
# Resend transactional email (vendor application confirmations + admin alerts).
# OPTIONAL: when unset, email sending no-ops with a warning — nothing breaks.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM="BidWise <notifications@bidwiseinvest.com>"
