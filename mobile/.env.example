# Copy to .env.local and fill in real values. .env.local is gitignored.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_URL=https://bidwiseinvest.com
# Comma-separated emails granted Expert-level access without a subscription.
EXPO_PUBLIC_ADMIN_EMAILS=

# RevenueCat (in-app purchases). Public SDK keys — safe client-side.
# Create in RevenueCat dashboard → Project → API keys (Apple/Google app keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry crash reporting. DSN is public/client-safe. When empty, Sentry is off.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog product analytics. Project API key is client-safe. When empty, off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
