{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://bidwiseinvest.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://bidwiseinvest.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6772646236",
        "appleTeamId": "KG2PM77A58"
      }
    }
  }
}
