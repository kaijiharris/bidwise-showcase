# Supabase — find at supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ── Stripe (live mode) ───────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (from Stripe)
# These are price_xxx IDs, NOT product IDs. If you recreate products in Stripe,
# update these to the new Price IDs from Dashboard → Products → Pricing.
STRIPE_STARTER_MONTHLY=
STRIPE_STARTER_ANNUAL=
STRIPE_PRO_MONTHLY=
STRIPE_PRO_ANNUAL=
STRIPE_EXPERT_MONTHLY=
STRIPE_EXPERT_ANNUAL=

# App
NEXT_PUBLIC_APP_URL=

# Team / Admin access — comma-separated emails get full Expert access at no charge
ADMIN_EMAILS=

#Google Credentials
Google_Client_ID=
Google_Client_Secret=

#Resend API Key
RESEND_API_KEY=
